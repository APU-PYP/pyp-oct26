#!/usr/bin/env bash
# check <project_name>: run the tests of a project.
#
#   check greeting   run every test file in the greeting project's tests folder
#   check            run the tests of the project you are currently in
source "$(dirname "$(readlink -f "$0")")/_lib.sh"

if [ $# -gt 0 ]; then
  name="$1"
  if [ -d "$name/src" ] && [ -d "$name/tests" ]; then
    project="$(cd "$name" && pwd -P)"
  elif [ -d "$REPO_ROOT/$name/src" ] && [ -d "$REPO_ROOT/$name/tests" ]; then
    project="$REPO_ROOT/$name"
  else
    echo "The project '$name' does not exist: create it first with \`create $name\`"
    exit 2
  fi
elif ! project="$(find_project)"; then
  echo "Usage   : check <project_name>"
  echo "Example : check greeting"
  exit 2
fi

target="tests"
cd "$project" || exit 1

exec python -m pytest -c "$LAB_DIR/pytest.ini" --rootdir="$project" --color=yes "$target"
